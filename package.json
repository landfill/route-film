{
  "name": "route-film",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One journey. An atlas, a film, a print. Original procedural travel storytelling.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "test:ui": "node scripts/ui-check.mjs",
    "test:browser": "node scripts/security-browser.mjs",
    "validate:portrait": "node scripts/validate.mjs --portrait",
    "export:atlas": "node scripts/export-atlas.mjs"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5"
  }
}
