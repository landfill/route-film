# Optional local settings. No API keys are required.
# Export these in the shell, or use Node's --env-file flag.
HOST=127.0.0.1
PORT=3000
# Additional exact hostnames, without scheme/port/wildcards. Loopback stays allowed.
ALLOWED_HOSTS=
# Exact browser origins for a configured proxy domain. Forwarded headers are ignored.
# ALLOWED_HOSTS=atlas.example.com
# ALLOWED_ORIGINS=https://atlas.example.com
ALLOWED_ORIGINS=
CHROMIUM_PATH=/usr/bin/chromium
RENDER_THREADS=2
# Shared heavy-work slots and total reservations (running + queued + initializing).
RENDER_CONCURRENCY=1
RENDER_QUEUE_LIMIT=3
# Optional persistent output directory (default: ./data)
# DATA_DIR=/absolute/path/to/route-film-data
